# Required, >= 24 chars. openssl rand -base64 32
HERMES_MCP_TOKEN=
PORT=8788
HOST=0.0.0.0
MCP_PATH=/mcp
# Where the hermes binary and home live (defaults match the official image)
# HERMES_BIN=hermes
# HERMES_HOME=/opt/data
# Default and maximum per-call timeouts in seconds
# HERMES_MCP_TIMEOUT_SEC=90
# HERMES_MCP_MAX_TIMEOUT_SEC=3600
# Only allow read-style commands (status, logs, sessions list, config show, ...)
# HERMES_MCP_READ_ONLY=1
# Comma-separated command names to unblock from the refusal list, e.g. "update"
# HERMES_MCP_ALLOW=
# Cap captured output per stream (bytes) and how long finished jobs stay pollable (minutes)
# HERMES_MCP_MAX_OUTPUT=200000
# HERMES_MCP_JOB_TTL_MIN=120
