#!/command/with-contenv sh
# shellcheck shell=sh
# OpenAI-compatible gateway API (hermes serve). Mirrors the hermes-mcp
# service: if the API server is not enabled or has no key, exit 0 and let
# ./finish mark the slot as permanently down rather than crash-looping.

if [ "${API_SERVER_ENABLED:-}" != "true" ] && [ "${API_SERVER_ENABLED:-}" != "1" ]; then
    echo "[api-server] API_SERVER_ENABLED not set; not starting" >&2
    exit 0
fi

if [ -z "${API_SERVER_KEY:-}" ]; then
    echo "[api-server] API_SERVER_KEY not set; refusing to start an unauthenticated API" >&2
    exit 0
fi

# with-contenv repopulates HOME as /root. Reset it before dropping privileges
# so anything hermes writes lands under /opt/data.
export HOME=/opt/data
export HERMES_HOME="${HERMES_HOME:-/opt/data}"
export PATH="/opt/hermes/bin:/opt/hermes/.venv/bin:/opt/data/.local/bin:${PATH}"

API_HOST="${API_SERVER_HOST:-127.0.0.1}"
API_PORT="${API_SERVER_PORT:-8642}"

cd /opt/data

[ "$(id -u)" = 0 ] || exec hermes serve --host "${API_HOST}" --port "${API_PORT}"
exec s6-setuidgid hermes hermes serve --host "${API_HOST}" --port "${API_PORT}"
