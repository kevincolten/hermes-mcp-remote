#!/command/with-contenv sh
# shellcheck shell=sh
# hermes-mcp-remote service. Mirrors the dashboard service: if no token is
# configured, exit 0 and let ./finish mark the slot as permanently down.

if [ -z "${HERMES_MCP_TOKEN:-}" ]; then
    echo "[hermes-mcp] HERMES_MCP_TOKEN not set; not starting" >&2
    exit 0
fi

# with-contenv repopulates HOME as /root. Reset it before dropping privileges
# so anything hermes writes lands under /opt/data.
export HOME=/opt/data
export HERMES_HOME="${HERMES_HOME:-/opt/data}"
export PATH="/opt/hermes/bin:/opt/hermes/.venv/bin:/opt/data/.local/bin:${PATH}"

cd /opt/data

[ "$(id -u)" = 0 ] || exec node /opt/hermes-mcp/src/server.js
exec s6-setuidgid hermes node /opt/hermes-mcp/src/server.js
